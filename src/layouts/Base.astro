---
import '@fontsource/pt-mono/400.css';
import '@fontsource/pt-sans/400.css';
import '@fontsource/pt-sans/700.css';
import '@fontsource/pt-serif/400.css';
import '@fontsource/pt-serif/400-italic.css';
import '@fontsource/pt-serif/700.css';
import '@fontsource/pt-serif/700-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import { altPaths, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  /** Абсолютный или корневой путь к картинке превью (1200×630) */
  ogImage?: string;
  type?: 'website' | 'article' | 'profile';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  /** Структурированные данные schema.org (см. src/lib/seo.ts) */
  jsonLd?: object;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description[Astro.props.lang ?? 'ru'],
  lang = 'ru',
  ogImage = '/og/default.png',
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  jsonLd,
  noindex = false,
} = Astro.props;

const author = SITE.author[lang];
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(ogImage, Astro.site);
const fullTitle = title === author ? title : `${title} — ${author}`;
// Языковые версии одной страницы: у главной, CV и докладов есть пара на другом языке
const altPath = altPaths[Astro.url.pathname];
const hreflang = altPath
  ? [
      { lang, href: canonical.toString() },
      { lang: lang === 'ru' ? 'en' : 'ru', href: new URL(altPath, Astro.site).toString() },
      { lang: 'x-default', href: new URL(lang === 'ru' ? Astro.url.pathname : altPath, Astro.site).toString() },
    ]
  : [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="canonical" href={canonical} />
    {hreflang.map((h) => <link rel="alternate" hreflang={h.lang} href={h.href} />)}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.author.ru} — статьи`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161618" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph: карточка ссылки в Telegram, VK, Slack и т. д. -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={author} />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {type === 'article' && (
      <>
        <meta property="article:author" content={author} />
        {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
        {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
        {tags.map((tag) => <meta property="article:tag" content={tag} />)}
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Канал автора: Instant View показывает кнопку подписки -->
    <meta property="telegram:channel" content={SITE.telegramChannel} />

    <script is:inline>
      (() => {
        let theme = null;
        try { theme = localStorage.getItem('theme'); } catch {}
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      })();
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
  </head>
  <body>
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
