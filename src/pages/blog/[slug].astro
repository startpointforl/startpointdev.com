---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ShareButton from '../../components/ShareButton.astro';
import { getArticles, getSeriesNav, isScheduled } from '../../lib/content';
import { SITE, instantViewUrl } from '../../data/site';
import { formatDate } from '../../i18n/ui';
import { breadcrumbsLd, graph } from '../../lib/seo';

export async function getStaticPaths() {
  const all = await getArticles({ withScheduled: true });
  const published = all.filter((a) => !isScheduled(a));
  return Promise.all(
    all.map(async (article) => {
      // Запланированная статья видит в цикле опубликованные части и себя; другим статьям она пока не видна
      const scheduled = !published.includes(article);
      const nav = await getSeriesNav(article, scheduled ? [...published, article] : published);
      return { params: { slug: article.id }, props: { article, nav, scheduled } };
    }),
  );
}

interface Props {
  article: CollectionEntry<'articles'>;
  nav: Awaited<ReturnType<typeof getSeriesNav>>;
  scheduled: boolean;
}
const { article, nav, scheduled } = Astro.props;
// Страница цикла появляется вместе с первой опубликованной частью
const seriesLive = nav?.parts.some((p) => p.id !== article.id || !scheduled);
// Ссылка на соседнюю часть, которая открывается сразу в Instant View
const ivLink = (id: string) => instantViewUrl(new URL(`/blog/${id}/`, Astro.site).toString());
const { Content } = await render(article);
const { title, description, date, updated, tags, cover, lang } = article.data;
const ogImage = cover ?? `/og/${article.id}.png`;
const url = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = graph(
  {
    '@type': 'BlogPosting',
    headline: title,
    description,
    url,
    mainEntityOfPage: url,
    inLanguage: lang,
    datePublished: date.toISOString(),
    dateModified: (updated ?? date).toISOString(),
    image: new URL(ogImage, Astro.site).toString(),
    keywords: tags.join(', ') || undefined,
    author: { '@type': 'Person', '@id': `${SITE.url}/#person`, name: SITE.author[lang], url: `${SITE.url}/` },
    isPartOf: nav
      ? { '@type': 'CreativeWorkSeries', name: nav.series.data.title, url: new URL(`/series/${nav.series.id}/`, Astro.site).toString() }
      : undefined,
    position: nav ? article.data.part : undefined,
  },
  breadcrumbsLd([
    { name: 'Главная', path: '/' },
    { name: 'Статьи', path: '/blog/' },
    ...(nav ? [{ name: nav.series.data.title, path: `/series/${nav.series.id}/` }] : []),
    { name: title, path: Astro.url.pathname },
  ]),
);
---

<Base title={title} description={description} lang={lang} type="article" ogImage={ogImage}
  publishedTime={date} modifiedTime={updated} tags={tags} jsonLd={jsonLd} noindex={scheduled}>
  <!-- Разметка рассчитана на шаблон Instant View: article h1, .author, time, .article-body -->
  <article class="narrow" data-pagefind-body={!scheduled || undefined}>
    <header class="head">
      {nav && (
        <p class="kicker" data-pagefind-ignore>
          {seriesLive ? <a href={`/series/${nav.series.id}/`}>{nav.series.data.title}</a> : nav.series.data.title} · часть {article.data.part} из {nav.parts.length}
        </p>
      )}
      <h1 data-pagefind-meta="title">{title}</h1>
      <p class="meta" data-pagefind-ignore>
        <span class="author">{SITE.author[lang]}</span> · <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
      </p>
      {nav && nav.parts.length > 1 && (
        <details class="toc" data-pagefind-ignore>
          <summary>оглавление цикла</summary>
          <ol>
            {nav.parts.map((p) => (
              <li aria-current={p.id === article.id ? 'page' : undefined}>
                <span>{p.data.part}.</span>
                {p.id === article.id ? <span>{p.data.title}</span> : <a href={`/blog/${p.id}/`}>{p.data.title}</a>}
              </li>
            ))}
          </ol>
        </details>
      )}
    </header>

    <div class="article-body prose">
      <Content />
    </div>

    <footer class="foot" data-pagefind-ignore>
      {nav && (nav.prev || nav.next) && (
        <nav class="pager" aria-label="Навигация по циклу">
          {nav.prev ? (
            <a href={`/blog/${nav.prev.id}/`} class="prev"><span>← часть {nav.prev.data.part}</span>{nav.prev.data.title}</a>
          ) : <span />}
          {nav.next ? (
            <a href={`/blog/${nav.next.id}/`} class="next"><span>часть {nav.next.data.part} →</span>{nav.next.data.title}</a>
          ) : <span />}
        </nav>
      )}
      <div class="share"><ShareButton url={url} /></div>
      <!-- Только для Instant View: на сайте скрыто, шаблон IV дописывает этот блок в конец статьи -->
      {nav && (nav.prev || nav.next) && (
        <div class="iv-series" hidden>
          <hr />
          <h3>Цикл «{nav.series.data.title}»</h3>
          {nav.prev && <p><a href={ivLink(nav.prev.id)}>← Предыдущая часть: {nav.prev.data.title}</a></p>}
          {nav.next && <p><a href={ivLink(nav.next.id)}>Следующая часть: {nav.next.data.title} →</a></p>}
        </div>
      )}
    </footer>
  </article>
</Base>

<!-- Кнопка «наверх»: появляется, когда статью прокрутили дальше полутора экранов -->
<button class="to-top" type="button" aria-label="Наверх" title="Наверх">
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <path d="M12 19V5M5 12l7-7 7 7" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</button>

<!-- Картинки в статье открываются по клику в полном размере -->
<div class="zoom" hidden role="dialog" aria-modal="true" aria-label="Картинка в полном размере">
  <img alt="" />
</div>

<script>
  const zoom = document.querySelector<HTMLDivElement>('.zoom')!;
  const zoomImg = zoom.querySelector('img')!;

  // Самая большая версия из srcset — это картинка в исходном размере
  const largest = (img: HTMLImageElement) => {
    const candidates = (img.getAttribute('srcset') || '')
      .split(',')
      .map((c) => c.trim().split(/\s+/))
      .filter(([url, w]) => url && w?.endsWith('w'))
      .map(([url, w]) => ({ url, w: parseInt(w) }));
    return candidates.sort((a, b) => b.w - a.w)[0]?.url || img.currentSrc || img.src;
  };

  const close = () => {
    zoom.hidden = true;
    document.body.style.overflow = '';
  };

  document.querySelectorAll<HTMLImageElement>('.article-body figure img').forEach((img) => {
    img.tabIndex = 0;
    img.setAttribute('role', 'button');
    img.title = 'Открыть в полном размере';
    const open = () => {
      zoomImg.removeAttribute('style');
      zoomImg.onload = () => {
        // пиксель в пиксель с учётом плотности экрана: скриншоты с ретины не раздуваются вдвое
        zoomImg.style.width = `${Math.round(zoomImg.naturalWidth / window.devicePixelRatio)}px`;
      };
      zoomImg.src = largest(img);
      zoomImg.alt = img.alt;
      zoom.hidden = false;
      zoom.scrollTo(0, 0);
      document.body.style.overflow = 'hidden';
    };
    img.addEventListener('click', open);
    img.addEventListener('keydown', (e) => (e.key === 'Enter' || e.key === ' ') && (e.preventDefault(), open()));
  });

  zoom.addEventListener('click', close);

  const toTop = document.querySelector<HTMLButtonElement>('.to-top')!;
  const updateToTop = () => toTop.classList.toggle('visible', window.scrollY > window.innerHeight * 1.5);
  window.addEventListener('scroll', updateToTop, { passive: true });
  updateToTop();
  toTop.addEventListener('click', () => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
  });
  document.addEventListener('keydown', (e) => e.key === 'Escape' && !zoom.hidden && close());
</script>

<style>
  :global(.article-body figure img) { cursor: zoom-in; }
  .to-top {
    position: fixed; z-index: 50;
    right: max(16px, env(safe-area-inset-right)); bottom: max(16px, calc(env(safe-area-inset-bottom) + 8px));
    display: grid; place-items: center; width: 2.75rem; height: 2.75rem; padding: 0; cursor: pointer;
    color: var(--muted); background: var(--surface); border: 1px solid var(--line); border-radius: 50%;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.08);
    /* скрытая кнопка не ловит клики и фокус */
    opacity: 0; visibility: hidden; transform: translateY(8px);
    transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
  }
  .to-top.visible { opacity: 1; visibility: visible; transform: none; }
  .to-top:hover { color: var(--accent); border-color: var(--accent); }
  @media (prefers-reduced-motion: reduce) { .to-top { transition: none; } }
  .zoom {
    position: fixed; inset: 0; z-index: 100; overflow: auto; cursor: zoom-out;
    display: grid; place-items: safe center; padding: 2rem;
    background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(2px);
  }
  .zoom[hidden] { display: none; }
  /* Картинка в исходном размере; если шире экрана — прокручивается */
  .zoom img { max-width: none; height: auto; border-radius: 4px; box-shadow: 0 8px 40px rgb(0 0 0 / 0.25); }
  .head { padding: 1.5rem 0 2rem; }
  .kicker { font: 400 14px var(--mono); color: var(--muted); margin: 0 0 0.8rem; }
  .kicker a { color: var(--accent); }
  h1 { font-size: 2.1rem; line-height: 1.25; letter-spacing: -0.01em; }
  .meta { font: 400 14px var(--mono); color: var(--muted); margin: 1rem 0 0; }
  .toc { margin-top: 1.5rem; border: 1px solid var(--line); border-radius: 6px; padding: 0.7rem 1rem; font-size: 15px; }
  .toc summary { font: 400 14px var(--mono); color: var(--muted); cursor: pointer; }
  .toc ol { list-style: none; padding: 0; margin: 0.6rem 0 0.2rem; }
  .toc li { display: grid; grid-template-columns: 1.75rem 1fr; padding: 0.2rem 0; }
  .toc li span:first-child { font-family: var(--mono); color: var(--muted); }
  .toc li[aria-current='page'] { color: var(--accent); }
  .foot { margin-top: 3.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 1.5rem; }
  .pager a { display: flex; flex-direction: column; gap: 0.3rem; padding: 0.9rem 1rem; border: 1px solid var(--line); border-radius: 6px; font: 400 15px/1.4 var(--mono); }
  .pager a:hover { border-color: var(--accent); }
  .pager a span { font-size: 13px; color: var(--muted); }
  .pager .next { text-align: right; }
  .share { display: flex; justify-content: flex-end; }
  @media (max-width: 600px) {
    h1 { font-size: 1.65rem; }
    .pager { grid-template-columns: 1fr; }
  }
</style>
