---
import { instantViewUrl } from '../data/site';
import { t } from '../i18n/ui';

interface Props { url: string }
const tr = t('ru');
---

<button class="btn share" type="button" data-url={instantViewUrl(Astro.props.url)} data-done={tr('share.copied')}>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.9 4.3 18.7 19.4c-.2 1.1-.9 1.3-1.8.8l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.3-5 9.1-8.2c.4-.4-.1-.6-.6-.2L6.2 13 1.4 11.5c-1-.3-1.1-1 .2-1.5L20.5 2.8c.9-.3 1.7.2 1.4 1.5z"/></svg>
  <span>{tr('share.telegram')}</span>
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>('.share').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const label = btn.querySelector('span')!;
      const original = label.textContent;
      try {
        await navigator.clipboard.writeText(btn.dataset.url!);
        label.textContent = btn.dataset.done!;
        setTimeout(() => (label.textContent = original), 1500);
      } catch {
        window.prompt('', btn.dataset.url);
      }
    });
  });
</script>
