---
import Base from '../layouts/Base.astro';
import TalkList from './TalkList.astro';
import Portrait from './Portrait.astro';
import { getTalks } from '../lib/content';
import { SITE } from '../data/site';
import { headline, about, skills, jobs } from '../data/cv';
import { t, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const talks = await getTalks();
---

<Base title={`${tr('cv.title')} · ${SITE.author[lang]}`} description={headline[lang]} lang={lang} type="profile">
  <div class="wide">
    <section class="top">
      <div class="photo"><Portrait lang={lang} eager /></div>
      <div>
        <h1>{SITE.author[lang]}</h1>
        <p class="role mono">{headline[lang].toLowerCase()}</p>
        <p class="contacts mono">
          <a href={`mailto:${SITE.links.email}`}>{SITE.links.email}</a>
          <a href={SITE.links.telegram}>telegram ↗</a>
          <a href={SITE.links.linkedin}>linkedin ↗</a>
        </p>
      </div>
    </section>

    <div class="section-head"><span>{tr('cv.about').toLowerCase()}</span></div>
    <div class="about">{about[lang].map((p) => <p>{p}</p>)}</div>

    <div class="section-head"><span>{tr('cv.skills').toLowerCase()}</span></div>
    <p class="skills mono">{skills.join(' · ')}</p>

    <div class="section-head"><span>{tr('cv.experience').toLowerCase()}</span></div>
    <ol class="jobs">
      {jobs.map((job) => (
        <li>
          <span class="d">{job.period[lang]}</span>
          <div>
            <h3>{job.role[lang]}</h3>
            <p class="where">{job.company[lang]} · {job.project[lang]}</p>
            {job.points[lang].length > 0 && <ul>{job.points[lang].map((p) => <li>{p}</li>)}</ul>}
          </div>
        </li>
      ))}
    </ol>

    <div class="section-head"><span>{tr('cv.talks').toLowerCase()}</span></div>
    <TalkList talks={talks} lang={lang} />
  </div>
</Base>

<style>
  .top { display: grid; grid-template-columns: 9rem 1fr; gap: 2rem; align-items: center; padding: 1.5rem 0 2.5rem; border-bottom: 1px solid var(--line); }
  h1 { font-size: 2.25rem; line-height: 1.15; }
  .role { color: var(--accent); margin: 0.5rem 0 0; }
  .contacts { display: flex; flex-wrap: wrap; gap: 0.3rem 1.25rem; margin: 1rem 0 0; font-size: 14px; color: var(--muted); }
  .about { max-width: 42rem; }
  .about p { margin: 0 0 0.9rem; }
  .skills { color: var(--muted); font-size: 15px; margin: 0; line-height: 1.8; }
  .jobs { list-style: none; padding: 0; margin: 0; }
  .jobs > li { display: grid; grid-template-columns: 11rem 1fr; gap: 1.25rem; padding: 0.9rem 0; }
  .d { font: 400 14px var(--mono); color: var(--muted); padding-top: 0.15rem; }
  h3 { font-size: 1.1rem; line-height: 1.4; }
  .where { font: 400 13px var(--mono); color: var(--muted); margin: 0.15rem 0 0; }
  .jobs ul { margin: 0.5rem 0 0; padding-left: 1.1rem; }
  .jobs ul li { margin: 0.25rem 0; }
  .jobs ul li::marker { color: var(--accent); }
  @media (max-width: 640px) {
    .top { grid-template-columns: 1fr; gap: 1.25rem; }
    .photo { max-width: 8rem; }
    .contacts a { overflow-wrap: anywhere; }
    h1 { font-size: 1.6rem; }
    .jobs > li { grid-template-columns: 1fr; gap: 0.1rem; }
  }
  @media print {
    :global(.header), :global(.footer) { display: none; }
  }
</style>
