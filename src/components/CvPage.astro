---
import Base from '../layouts/Base.astro';
import TalkList from './TalkList.astro';
import Portrait from './Portrait.astro';
import { getTalks } from '../lib/content';
import { SITE } from '../data/site';
import { headline, location, about, beyondWork, education, skills, jobs } from '../data/cv';
import { t, type Lang } from '../i18n/ui';
import { personLd, graph } from '../lib/seo';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const talks = await getTalks();
const jsonLd = graph({
  '@type': 'ProfilePage',
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  inLanguage: lang,
  mainEntity: await personLd(lang),
});
---

<Base title={`${tr('cv.title')} · ${SITE.author[lang]}`} description={headline[lang]} lang={lang} type="profile" jsonLd={jsonLd}>
  <div class="wide">
    <section class="top">
      <div class="photo"><Portrait lang={lang} eager /></div>
      <div>
        <h1>{SITE.author[lang]}</h1>
        <p class="role mono">{headline[lang].toLowerCase()}</p>
        <p class="loc mono">{location[lang]}</p>
        <p class="contacts mono">
          <a href={`mailto:${SITE.links.email}`}>{SITE.links.email}</a>
          <a href={SITE.links.telegramPersonal} target="_blank" rel="noopener">telegram ↗</a>
          <a href={SITE.links.linkedin} target="_blank" rel="noopener">linkedin ↗</a>
          <a href={SITE.links.github} target="_blank" rel="noopener">github ↗</a>
        </p>
      </div>
    </section>

    <div class="section-head"><span>{tr('cv.about').toLowerCase()}</span></div>
    <div class="about">
      <div class="about-text">
        {about[lang].map((p) => <p>{p}</p>)}
        <p class="muted-label mono">{tr('cv.beyond').toLowerCase()}:</p>
        <ul>
          {beyondWork[lang].map((item) => (
            <li>
              {item.text}
              {item.link && <> <a class="inline-link" href={item.link.href} target="_blank" rel="noopener" title={tr('link.newTab')}>{item.link.label} ↗</a></>}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="section-head"><span>{tr('cv.experience').toLowerCase()}</span></div>
    <ol class="jobs">
      {jobs.map((job) => (
        <li>
          <span class="d">{job.period[lang]}</span>
          <div>
            <h3>{job.role}</h3>
            <p class="where">{job.company[lang]} · {job.project[lang]}</p>
            {job.points[lang].length > 0 && <ul>{job.points[lang].map((p) => <li>{p}</li>)}</ul>}
            {job.stack && <p class="stack mono"><span>{lang === 'ru' ? 'стек' : 'stack'}:</span> {job.stack.join(' · ')}</p>}
          </div>
        </li>
      ))}
    </ol>

    <div class="section-head"><span>{tr('cv.skills').toLowerCase()}</span></div>
    <dl class="skills">
      {skills.map((group) => (
        <div>
          <dt class="mono">{group.title[lang].toLowerCase()}</dt>
          <dd>{group.items[lang].join(' · ')}</dd>
        </div>
      ))}
    </dl>

    <div class="section-head"><span>{tr('cv.education').toLowerCase()}</span></div>
    <p class="edu">{education[lang]}</p>

    <div class="section-head"><span>{tr('cv.talks').toLowerCase()}</span></div>
    <TalkList talks={talks} lang={lang} />
  </div>
</Base>

<style>
  .top { display: grid; grid-template-columns: 9rem 1fr; gap: 2rem; align-items: center; padding: 1.5rem 0 2.5rem; border-bottom: 1px solid var(--line); }
  h1 { font-size: 2.25rem; line-height: 1.15; }
  .role { color: var(--accent); margin: 0.5rem 0 0; }
  .loc { color: var(--muted); font-size: 14px; margin: 0.35rem 0 0; }
  .contacts { display: flex; flex-wrap: wrap; gap: 0.3rem 1.25rem; margin: 0.9rem 0 0; font-size: 14px; color: var(--muted); }
  .about { max-width: 42rem; }
  .about-text p { margin: 0 0 0.9rem; }
  .about-text ul { margin: 0; padding-left: 1.1rem; }
  .about-text li { margin: 0.2rem 0; }
  .about-text li::marker, .jobs ul li::marker { color: var(--accent); }
  .muted-label { color: var(--muted); font-size: 14px; margin-top: 1.25rem !important; }
  .jobs { list-style: none; padding: 0; margin: 0; }
  .jobs > li { display: grid; grid-template-columns: 11rem 1fr; gap: 1.25rem; padding: 0.9rem 0; }
  .d { font: 400 14px var(--mono); color: var(--muted); padding-top: 0.15rem; }
  h3 { font-size: 1.1rem; line-height: 1.4; }
  .where { font: 400 13px var(--mono); color: var(--muted); margin: 0.15rem 0 0; }
  .jobs ul { margin: 0.5rem 0 0; padding-left: 1.1rem; }
  .jobs ul li { margin: 0.25rem 0; }
  .skills { margin: 0; }
  .skills > div { display: grid; grid-template-columns: 11rem 1fr; gap: 1.25rem; padding: 0.45rem 0; }
  .skills dt { color: var(--muted); font-size: 14px; padding-top: 0.1rem; }
  .skills dd { margin: 0; }
  .edu { margin: 0; }
  .stack { font-size: 13px; color: var(--muted); margin: 0.6rem 0 0; line-height: 1.6; }
  .stack span { color: var(--accent); }
  .inline-link { color: var(--accent); font: 400 14px var(--mono); }
  @media (max-width: 640px) {
    .top { grid-template-columns: 1fr; gap: 1.25rem; }
    .photo { max-width: 8rem; }
    .contacts a { overflow-wrap: anywhere; }
    h1 { font-size: 1.6rem; }
    .jobs > li, .skills > div { grid-template-columns: 1fr; gap: 0.1rem; }
  }
  @media print {
    :global(.header), :global(.footer) { display: none; }
  }
</style>
