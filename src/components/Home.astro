---
import Base from '../layouts/Base.astro';
import ArticleList from './ArticleList.astro';
import TalkList from './TalkList.astro';
import Portrait from './Portrait.astro';
import { getArticles, getTalks } from '../lib/content';
import { SITE } from '../data/site';
import { t, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const prefix = lang === 'en' ? '/en' : '';
const articles = (await getArticles()).slice(0, 5);
const talks = (await getTalks()).slice(0, 4);

const copy = {
  ru: {
    kicker: 'Senior frontend · Яндекс Пэй',
    title: ['Разбираю, как', 'на самом деле', 'работают Node.js, V8 и браузеры'],
    lead: 'Пишу длинные разборы, выступаю на конференциях и веду телеграм-канал',
    caption: 'Анастасия Котова — фото скоро',
  },
  en: {
    kicker: 'Senior frontend · Yandex Pay',
    title: ['Digging into how', 'Node.js, V8 and browsers', 'really work'],
    lead: 'I write long-form deep dives, speak at conferences and run the Telegram channel',
    caption: 'Anastasia Kotova — photo coming soon',
  },
}[lang];
---

<Base title={SITE.author[lang]} lang={lang}>
  <section class="hero wide">
    <div class="text">
      <p class="mono kicker">{copy.kicker}</p>
      <h1 class="display">{copy.title[0]} <em>{copy.title[1]}</em> {copy.title[2]}</h1>
      <p class="lead">{copy.lead} <a href={SITE.links.telegram}>{SITE.telegramChannel}</a>.</p>
    </div>
    <div class="photo"><Portrait lang={lang} caption={copy.caption} eager /></div>
  </section>

  <div class="wide">
    <div class="section-head">
      <span class="num">01</span><h2>{tr('blog.title')}</h2><a href="/blog/">{tr('blog.all')} →</a>
    </div>
    <ArticleList articles={articles} lang={lang} />

    <div class="section-head">
      <span class="num">02</span><h2>{tr('talks.title')}</h2><a href={`${prefix}/talks/`}>{tr('talks.all')} →</a>
    </div>
    <TalkList talks={talks} lang={lang} />
  </div>
</Base>

<style>
  .hero {
    display: grid; grid-template-columns: minmax(0, 1fr) 20rem; gap: 4rem; align-items: end;
    padding-top: 3.5rem; padding-bottom: 1rem;
  }
  .kicker { color: var(--accent); margin: 0 0 1.25rem; }
  h1 { font-size: clamp(2.8rem, 7vw, 5.6rem); }
  .lead { margin: 1.75rem 0 0; max-width: 32rem; }
  @media (max-width: 820px) {
    .hero { grid-template-columns: 1fr; gap: 2.5rem; padding-top: 2rem; }
    .photo { max-width: 16rem; }
  }
</style>
