---
import Base from '../layouts/Base.astro';
import ArticleList from './ArticleList.astro';
import SeriesCards from './SeriesCards.astro';
import TalkList from './TalkList.astro';
import Portrait from './Portrait.astro';
import { getArticles, getTalks, getSeriesList, getStandalone } from '../lib/content';
import { SITE } from '../data/site';
import { headline } from '../data/cv';
import { t, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const prefix = lang === 'en' ? '/en' : '';
const articles = await getArticles();
const series = (await getSeriesList(articles)).slice(0, 6);
const standalone = getStandalone(articles).slice(0, 5);
const talks = (await getTalks()).slice(0, 3);

const intro = {
  ru: 'Разбираюсь, как устроены Node.js, V8 и браузеры изнутри, пишу об этом статьи и рассказываю на конференциях. Веду телеграм-канал',
  en: 'I dig into how Node.js, V8 and browsers work under the hood, write about it and talk about it at conferences. I run the Telegram channel',
}[lang];
---

<Base title={SITE.author[lang]} lang={lang}>
  <div class="wide">
    <section class="hero">
      <div>
        <h1>{SITE.author[lang]}</h1>
        <p class="role mono">{headline[lang].toLowerCase()}</p>
        <p class="intro">{intro} <a class="link" href={SITE.links.telegram}>{SITE.telegramChannel}</a>.</p>
      </div>
      <div class="photo"><Portrait lang={lang} eager /></div>
    </section>

    {series.length > 0 && (
      <>
        <div class="section-head"><span>{tr('home.series')}</span><a href="/blog/">{tr('section.all')}</a></div>
        <SeriesCards items={series} />
      </>
    )}

    {standalone.length > 0 && (
      <>
        <div class="section-head"><span>{tr('home.standalone')}</span><a href="/blog/">{tr('section.all')}</a></div>
        <ArticleList articles={standalone} />
      </>
    )}

    <div class="section-head"><span>{tr('talks.title').toLowerCase()}</span><a href={`${prefix}/talks/`}>{tr('section.all')}</a></div>
    <TalkList talks={talks} lang={lang} />
  </div>
</Base>

<style>
  .hero {
    display: grid; grid-template-columns: 1fr 12.5rem; gap: 3rem; align-items: start;
    padding: 1.5rem 0 3.5rem; border-bottom: 1px solid var(--line);
  }
  h1 { font-size: 2.5rem; line-height: 1.15; letter-spacing: -0.01em; }
  .role { color: var(--accent); margin: 0.6rem 0 0; }
  .intro { color: var(--muted); margin: 1.25rem 0 0; max-width: 34rem; }
  .intro a { color: var(--text); }
  @media (max-width: 640px) {
    .hero { grid-template-columns: 1fr; gap: 1.75rem; }
    .photo { max-width: 11rem; grid-row: 1; }
    h1 { font-size: 2rem; }
  }
</style>
