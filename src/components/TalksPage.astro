---
import Base from '../layouts/Base.astro';
import TalkList from './TalkList.astro';
import { getTalks } from '../lib/content';
import { t, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const talks = await getTalks();
const years = [...new Set(talks.map((x) => x.data.date.getUTCFullYear()))];
const lead = {
  ru: 'Конференции и митапы, на которых я рассказывала про внутренности JavaScript-платформы.',
  en: 'Conferences and meetups where I talked about JavaScript platform internals. Most talks are in Russian.',
}[lang];
---

<Base title={tr('talks.title')} lang={lang}>
  <div class="wide">
    <header class="page-head">
      <h1>{tr('talks.title')}</h1>
      <p>{lead}</p>
    </header>
    {years.map((year) => (
      <section>
        <div class="section-head"><span>{year}</span></div>
        <TalkList talks={talks.filter((x) => x.data.date.getUTCFullYear() === year)} lang={lang} />
      </section>
    ))}
  </div>
</Base>
