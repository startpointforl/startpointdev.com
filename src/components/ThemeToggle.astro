---
interface Props { label: string }
---

<button class="theme-toggle" type="button" aria-label={Astro.props.label} title={Astro.props.label}>◐</button>

<style>
  .theme-toggle {
    font: 1rem/1 var(--mono); padding: 0.1rem 0.2rem; border: 0; background: none; color: var(--ink); cursor: pointer;
    transition: transform 0.3s;
  }
  .theme-toggle:hover { color: var(--accent); transform: rotate(180deg); }
</style>

<script>
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  document.querySelectorAll('.theme-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const current = root.dataset.theme ?? (media.matches ? 'dark' : 'light');
      const next = current === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
    });
  });
</script>
