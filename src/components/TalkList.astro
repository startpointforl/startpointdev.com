---
import type { CollectionEntry } from 'astro:content';
import { t, formatIso, type Lang } from '../i18n/ui';

interface Props { talks: CollectionEntry<'talks'>[]; lang: Lang; abstracts?: boolean }
const { talks, lang, abstracts = false } = Astro.props;
const tr = t(lang);
const now = Date.now();
---

<ol class="talks">
  {talks.map(({ data: talk }) => {
    const title = lang === 'en' && talk.titleEn ? talk.titleEn : talk.title;
    const note = lang === 'en' ? talk.noteEn : talk.note;
    const place = talk.format === 'online' ? tr('talks.online') : talk.format === 'hybrid' ? `${talk.city} + ${tr('talks.online')}` : talk.city;
    return (
      <li>
        <span class="d">{talk.dateLabel ?? formatIso(talk.date)}</span>
        <div>
          <div class="e">
            {talk.event}{place && ` · ${place}`}
            {talk.date.valueOf() > now && <span class="badge">{tr('talks.upcoming')}</span>}
          </div>
          <div class="t">{title}</div>
          {lang === 'en' && talk.lang === 'ru' && <div class="n">Talk in Russian</div>}
          {note && <div class="n">{note}</div>}
          {abstracts && talk.abstract && lang === 'ru' && <p class="a">{talk.abstract}</p>}
          {(talk.video || talk.slides || talk.page) && (
            <div class="l">
              {talk.video && <a href={talk.video}>▶ {tr('talks.video')}</a>}
              {talk.slides && <a href={talk.slides}>{tr('talks.slides')}</a>}
              {talk.page && <a href={talk.page}>{tr('talks.page')} ↗</a>}
            </div>
          )}
        </div>
      </li>
    );
  })}
</ol>

<style>
  .talks { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: 7.5rem 1fr; gap: 1.25rem; padding: 0.8rem 0; }
  .d { font: 400 14px var(--mono); color: var(--muted); padding-top: 0.15rem; }
  .e { font: 400 13px var(--mono); color: var(--muted); display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap; }
  .t { font: 400 1.1rem/1.4 var(--mono); margin-top: 0.15rem; }
  .n { color: var(--muted); font-size: 15px; margin-top: 0.2rem; }
  .a { margin: 0.4rem 0 0; color: var(--muted); font-size: 15px; line-height: 1.55; max-width: 40rem; }
  .l { display: flex; gap: 1.1rem; font: 400 13px var(--mono); color: var(--accent); margin-top: 0.35rem; }
  @media (max-width: 560px) { li { grid-template-columns: 1fr; gap: 0.1rem; } }
</style>
