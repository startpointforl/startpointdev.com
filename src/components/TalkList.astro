---
import type { CollectionEntry } from 'astro:content';
import { t, formatDate, type Lang } from '../i18n/ui';

interface Props { talks: CollectionEntry<'talks'>[]; lang: Lang }
const { talks, lang } = Astro.props;
const tr = t(lang);
const now = Date.now();
---

<ol class="talks">
  {talks.map(({ data: talk }) => {
    const title = lang === 'en' && talk.titleEn ? talk.titleEn : talk.title;
    const note = lang === 'en' ? talk.noteEn : talk.note;
    const upcoming = talk.date.valueOf() > now;
    const date = talk.dateLabel ?? formatDate(talk.date, lang, { month: 'short', year: 'numeric' });
    const place = talk.format === 'online' ? tr('talks.online') : talk.format === 'hybrid' ? `${talk.city} + ${tr('talks.online')}` : talk.city;
    return (
      <li>
        <div class="when mono">
          <span>{date}</span>
          {upcoming && <span class="tag accent">{tr('talks.upcoming')}</span>}
        </div>
        <div>
          <p class="event mono">{talk.event}{place && <span class="muted"> — {place}</span>}</p>
          <p class="title">{title}</p>
          {lang === 'en' && talk.lang === 'ru' && <p class="note">Talk in Russian</p>}
          {note && <p class="note">{note}</p>}
          {(talk.video || talk.slides || talk.page) && (
            <p class="links mono">
              {talk.video && <a href={talk.video}>▶ {tr('talks.video')}</a>}
              {talk.slides && <a href={talk.slides}>{tr('talks.slides')}</a>}
              {talk.page && <a href={talk.page}>{tr('talks.page')} ↗</a>}
            </p>
          )}
        </div>
      </li>
    );
  })}
</ol>

<style>
  .talks { list-style: none; margin: 0; padding: 0; }
  li {
    display: grid; grid-template-columns: 8rem 1fr; gap: 1.25rem;
    padding: 1.25rem 0; border-bottom: 1px solid var(--rule-soft);
  }
  li:last-child { border-bottom: 0; }
  .when { display: flex; flex-direction: column; align-items: flex-start; gap: 0.4rem; padding-top: 0.2rem; }
  p { margin: 0; }
  .event { color: var(--ink); }
  .title { font-family: var(--display); font-weight: 600; font-size: 1.6rem; line-height: 1.1; margin-top: 0.3rem; }
  .note { font-style: italic; color: var(--ink-2); margin-top: 0.3rem; }
  .links { display: flex; gap: 1.25rem; margin-top: 0.6rem; }
  @media (max-width: 560px) {
    li { grid-template-columns: 1fr; gap: 0.4rem; }
    .when { flex-direction: row; }
  }
</style>
