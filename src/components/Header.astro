---
import ThemeToggle from './ThemeToggle.astro';
import { t, altPaths, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const prefix = lang === 'en' ? '/en' : '';
const path = Astro.url.pathname;
// Статьи только на русском, поэтому «статьи» в EN-версии ведут на /blog/
const nav = [
  { href: `${prefix}/`, label: tr('nav.home'), exact: true },
  { href: '/blog/', label: tr('nav.blog'), also: '/series/' },
  { href: `${prefix}/talks/`, label: tr('nav.talks') },
  { href: `${prefix}/cv/`, label: tr('nav.cv') },
];
const isCurrent = (item: (typeof nav)[number]) =>
  item.exact ? path === item.href : path.startsWith(item.href) || (item.also !== undefined && path.startsWith(item.also));
const alt = altPaths[path] ?? (lang === 'ru' ? '/en/' : '/');
---

<header class="header wide">
  <a href={`${prefix}/`} class="logo">startpoint.dev</a>
  <nav>
    {nav.map((item) => <a href={item.href} aria-current={isCurrent(item) ? 'page' : undefined}>{item.label}</a>)}
    <a href={alt} hreflang={lang === 'ru' ? 'en' : 'ru'}>{tr('lang.switch')}</a>
    <ThemeToggle label={tr('theme.toggle')} />
  </nav>
</header>

<style>
  .header {
    display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem 1.5rem;
    padding-top: 1.75rem; padding-bottom: 1.75rem; font: 400 15px var(--mono);
  }
  nav { display: flex; align-items: center; flex-wrap: wrap; gap: 0.4rem 1.35rem; color: var(--muted); }
  nav a[aria-current='page'] { color: var(--text); }
  @media (max-width: 560px) { nav { gap: 0.4rem 1rem; } }
</style>
