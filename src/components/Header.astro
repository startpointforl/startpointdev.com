---
import ThemeToggle from './ThemeToggle.astro';
import { SITE } from '../data/site';
import { t, altPaths, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const prefix = lang === 'en' ? '/en' : '';
const path = Astro.url.pathname;
// Статьи только на русском, поэтому «Статьи» в EN-версии ведут на /blog/
const nav = [
  { href: '/blog/', label: tr('nav.blog') },
  { href: `${prefix}/talks/`, label: tr('nav.talks') },
  { href: `${prefix}/cv/`, label: tr('nav.cv') },
];
const alt = altPaths[path] ?? (lang === 'ru' ? '/en/' : '/');
---

<header class="container header">
  <a href={`${prefix}/`} class="brand">{SITE.author[lang]}</a>
  <nav>
    {nav.map((item) => (
      <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>
  <div class="tools">
    <a href={alt} class="lang" hreflang={lang === 'ru' ? 'en' : 'ru'}>{tr('lang.switch')}</a>
    <ThemeToggle label={tr('theme.toggle')} />
  </div>
</header>

<style>
  .header {
    display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem 1.25rem;
    padding-top: 1.5rem; padding-bottom: 1.5rem; margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }
  .brand { font-weight: 700; color: var(--text); text-decoration: none; margin-right: auto; }
  nav { display: flex; gap: 1rem; }
  nav a { color: var(--muted); text-decoration: none; }
  nav a:hover, nav a[aria-current='page'] { color: var(--text); }
  .tools { display: flex; align-items: center; gap: 0.5rem; }
  .lang { font-size: 0.8rem; font-weight: 600; color: var(--muted); text-decoration: none; padding: 0.3rem 0.4rem; }
  .lang:hover { color: var(--text); }
  @media (max-width: 520px) {
    .brand { flex-basis: 100%; }
    nav { margin-right: auto; }
  }
</style>
