---
// Фото автора. Положи файл в src/assets/photo.(jpg|png|webp) — подхватится автоматически.
// Пока файла нет, показывается заглушка с инициалами.
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { SITE } from '../data/site';

interface Props { lang: Lang; eager?: boolean }
const { lang, eager = false } = Astro.props;
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/photo.{jpg,jpeg,png,webp,avif}', { eager: true });
const photo = Object.values(photos)[0]?.default;
---

{photo ? (
  <Image src={photo} alt={SITE.author[lang]} widths={[240, 480, 720]} sizes="240px"
    loading={eager ? 'eager' : 'lazy'} class="portrait" />
) : (
  <div class="portrait placeholder" role="img" aria-label={SITE.author[lang]}>{lang === 'ru' ? 'АК' : 'AK'}</div>
)}

<style>
  .portrait { display: block; width: 100%; aspect-ratio: 5 / 6; object-fit: cover; border-radius: 6px; }
  .placeholder {
    display: grid; place-items: center; background: var(--surface); border: 1px solid var(--line);
    font: 400 3rem var(--mono); color: var(--muted);
  }
</style>
