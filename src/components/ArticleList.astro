---
import type { CollectionEntry } from 'astro:content';
import { formatIso } from '../i18n/ui';

interface Props {
  articles: CollectionEntry<'articles'>[];
  /** Показывать «часть N» вместо даты-колонки (для оглавления цикла) */
  numbered?: boolean;
  current?: string;
}
const { articles, numbered = false, current } = Astro.props;
---

<ol class="posts">
  {articles.map((a) => (
    <li aria-current={a.id === current ? 'page' : undefined}>
      <span class="d">{numbered ? `часть ${a.data.part}` : formatIso(a.data.date)}</span>
      <div>
        <a class="t" href={`/blog/${a.id}/`}>{a.data.title}</a>
        {a.data.draft && <span class="badge">draft</span>}
        <div class="g">
          {numbered ? formatIso(a.data.date) : a.data.tags.map((tag) => `#${tag}`).join(' ')}
        </div>
      </div>
    </li>
  ))}
</ol>

<style>
  .posts { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: 7.5rem 1fr; gap: 1.25rem; padding: 0.8rem 0; }
  .d { font: 400 14px var(--mono); color: var(--muted); padding-top: 0.2rem; }
  .t { font: 400 1.15rem/1.4 var(--mono); }
  .badge { margin-left: 0.5rem; }
  .g { font: 400 13px var(--mono); color: var(--muted); margin-top: 0.2rem; }
  li[aria-current='page'] .t { color: var(--accent); }
  @media (max-width: 560px) {
    li { grid-template-columns: 1fr; gap: 0.1rem; }
  }
</style>
