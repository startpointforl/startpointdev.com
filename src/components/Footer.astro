---
import { SITE } from '../data/site';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const colophon = {
  ru: 'Набрано шрифтами Cormorant Garamond, Literata и IBM Plex Mono. Сверстано на Astro.',
  en: 'Set in Cormorant Garamond, Literata and IBM Plex Mono. Built with Astro.',
};
---

<footer class="footer wide">
  <div class="links mono">
    <a href={SITE.links.telegram}>Telegram</a>
    <a href={SITE.links.linkedin}>LinkedIn</a>
    <a href={`mailto:${SITE.links.email}`}>Email</a>
    <a href="/rss.xml">RSS</a>
  </div>
  <p class="colophon">{colophon[lang]} © {new Date().getFullYear()} {SITE.author[lang]}</p>
</footer>

<style>
  .footer { margin-top: 6rem; padding-bottom: 3rem; }
  .links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; padding-top: 0.9rem; border-top: 3px double var(--ink); }
  .links a { text-decoration: none; }
  .colophon { font-style: italic; font-size: 0.9rem; color: var(--ink-2); margin: 1rem 0 0; max-width: 34rem; }
</style>
